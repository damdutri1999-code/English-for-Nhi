rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Không đăng nhập: chỉ mở đúng một tài liệu tiến độ (tên phải trùng CONFIG.docId trong index.html)
    match /learners/nhi-7k3q9x2m {
      allow read, write: if true;
    }
    // Nội dung bài học: chỉ các tài liệu w1..w18, đúng định dạng
    match /content/{doc} {
      allow read: if doc.matches('w[0-9]+');
      allow write: if doc.matches('w[0-9]+') && request.resource.data.keys().hasOnly(['json','at','deleted']);
    }
  }
}
